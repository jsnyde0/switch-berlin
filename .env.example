# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=True

SECRET_KEY=create-your-own-secret-key-abcdefghijklmnopqrstuvwxyz-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (all three empty -> console backend)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Django superuser (auto-created by entrypoint)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=abc123

# Postgres (pgvector/pgvector:pg17)
POSTGRES_DB=kinky_bubbles
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# LLM / agents
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOGFIRE_TOKEN=

# Telegram ingestion
TELEGRAM_BOT_TOKEN=
