# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=True

SECRET_KEY=create-your-own-secret-key-abcdefghijklmnopqrstuvwxyz-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (all three empty -> console backend)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Django superuser (auto-created by entrypoint)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=abc123

# Postgres (pgvector/pgvector:pg17)
POSTGRES_DB=switch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# LLM / agents
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOGFIRE_TOKEN=

# Telegram ingestion
TELEGRAM_BOT_TOKEN=

# Cloudflare Turnstile (signup CAPTCHA). For local dev, use the always-passes
# test keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA.
# For prod, register a site at cloudflare.com/turnstile and use real keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Legal contact / Impressum (required before setting PUBLIC_READ_ENABLED=True)
# manage.py check --deploy raises E006 if any required var is empty while
# PUBLIC_READ_ENABLED=True; raises W006 warning in DEBUG=True mode.
# ---------------------------------------------------------------------------
# Required (blocks public flip if empty):
IMPRESSUM_NAME=
IMPRESSUM_ADDRESS=
IMPRESSUM_EMAIL=

# Optional — second contact channel (phone number or leave empty):
IMPRESSUM_PHONE=

# Optional — defaults to IMPRESSUM_NAME / IMPRESSUM_ADDRESS if unset:
RESPONSIBLE_PERSON_NAME=
RESPONSIBLE_PERSON_ADDRESS=

# Optional — DSA Art. 11/12 contact point; defaults to IMPRESSUM_EMAIL if unset:
DSA_CONTACT_EMAIL=

HETZNER_API_KEY=

# Cloudflare API token for DNS edits on switch.berlin zone.
# Scope: Zone:DNS:Edit on the switch.berlin zone only (not Global API Key).
CLOUDFLARE_API_TOKEN=

# Hetzner Storage Box (BX11) — restic backup destination.
# Box password (used only for Hetzner Console / SMB; restic uses SSH key auth).
HETZNER_STORAGE_SWITCH_RESTIC_PASSWORD=
# Storage Box numeric ID, host, and username (output of POST /v1/storage_boxes).
RESTIC_STORAGEBOX_ID=
RESTIC_REPOSITORY_USER=
RESTIC_REPOSITORY_HOST=

# Restic snapshot encryption password (kb-6nq.3). DISASTER RECOVERY KEY:
# losing this = BX11 snapshots unrecoverable. Generated on the VPS during
# kb-backup install and stored at /etc/kb-backup/env (root:switch 0640).
# Mirror it here for safekeeping; also stash in 1Password / out-of-band store.
RESTIC_ENCRYPTION_PASSWORD=