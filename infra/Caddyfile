switch.berlin {
	encode zstd gzip

	# Security response headers (kb-c14). Django owns Strict-Transport-Security
	# (SECURE_HSTS_SECONDS in a_core/settings.py) so there's one source of truth
	# for HSTS rollout. Caddy adds the headers Django doesn't always emit, and
	# strips its own Server header to reduce fingerprinting.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# kb-833: defense-in-depth. Permissions-Policy opts out of sensor /
		# camera / payment APIs the site doesn't use, so a future XSS can't
		# unlock them. CORP same-site pairs with COOP (set in Django). DNS
		# prefetch off is minor privacy hardening.
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Resource-Policy "same-site"
		X-DNS-Prefetch-Control "off"
		-Server
	}

	reverse_proxy localhost:8000
}

www.switch.berlin {
	redir https://switch.berlin{uri} 308
}
